# TODO: Stage 2 - content coming next month
[Unit]
Description=PHOENIX VAULT partition (staging, temp evidence)
After=systemd-cryptsetup@phoenix\x2dvault.service
Requires=systemd-cryptsetup@phoenix\x2dvault.service

[Mount]
What=/dev/mapper/phoenix-vault
Where=/phoenix/vault
Type=btrfs
Options=defaults,compress=zstd:3,noatime

[Install]
WantedBy=multi-user.target
